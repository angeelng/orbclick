{
  "name": "orbclick",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dashboard": "vite --open /dashboard/",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "progress:metrics": "tsx scripts/progress-metrics.ts",
    "balance:curve": "tsx scripts/balance-curve.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.8",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^5.4.20",
    "vitest": "^2.1.9"
  }
}
